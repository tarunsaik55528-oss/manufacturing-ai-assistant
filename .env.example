SECRET_KEY=django-insecure-mfg-assistant-hackathon-2026-key-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank or omit to fallback to local SQLite for rapid prototyping/testing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mfg_assistant

# Google Cloud Firebase Firestore Configuration
USE_FIRESTORE=True
FIREBASE_PROJECT_ID=mfg-manual-assistant
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Optional: Inlined JSON service account key (useful for cloud deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────────
# Firebase Web SDK (public — safe to include in HTML)
# ─────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → General → Your apps → Web app
FIREBASE_WEB_API_KEY=your-web-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID_WEB=your-project-id

# ─────────────────────────────────────────────────
# Admin Google Login (server-side only — NEVER in frontend)
# Comma-separated list of Gmail addresses that get ADMIN role
# ─────────────────────────────────────────────────
ADMIN_EMAILS=youremail@gmail.com,otheradmin@gmail.com

# AI / RAG Configuration
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

